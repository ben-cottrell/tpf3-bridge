{
  "contract_version": "0.12.0",
  "status": "proposed_descriptors_not_running_server",
  "protocol_reference": "MCP 2026-07-28; actual host/version compatibility untested",
  "tools": [
    {
      "name": "rail.inspect",
      "description": "Inspect a bounded world region or asset summary. Read-only; no full-world dump.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "scope_ref": {
            "$ref": "#/$defs/Id"
          },
          "categories": {
            "type": "array",
            "items": {
              "enum": [
                "status",
                "terrain",
                "topology",
                "assets",
                "changes"
              ]
            },
            "minItems": 1,
            "maxItems": 5,
            "uniqueItems": true
          },
          "cursor": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              {
                "type": "null"
              }
            ]
          },
          "max_items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          }
        },
        "required": [
          "scope_ref",
          "categories",
          "cursor",
          "max_items"
        ],
        "additionalProperties": false,
        "$defs": {
          "Id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$"
          }
        }
      },
      "outputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "schema_version": {
            "const": "0.12.0"
          },
          "status": {
            "enum": [
              "complete",
              "running",
              "decision_required",
              "blocked",
              "failed",
              "cancelling",
              "cancelled"
            ]
          },
          "job_ref": {
            "anyOf": [
              {
                "$ref": "#/$defs/Id"
              },
              {
                "type": "null"
              }
            ]
          },
          "result_ref": {
            "anyOf": [
              {
                "$ref": "#/$defs/Id"
              },
              {
                "type": "null"
              }
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "detail_refs": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/Id"
            },
            "minItems": 0,
            "maxItems": 16
          },
          "error_codes": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/Id"
            },
            "minItems": 0,
            "maxItems": 32
          },
          "event_sequence": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "schema_version",
          "status",
          "job_ref",
          "result_ref",
          "summary",
          "detail_refs",
          "error_codes",
          "event_sequence"
        ],
        "additionalProperties": false,
        "$defs": {
          "Id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$"
          }
        }
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      }
    },
